{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "lib": ["ES2022", "DOM"], "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "electron/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
